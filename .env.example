# Mermail API Key (from app.mermail.com)
MERMAIL_API_KEY=your_mermail_api_key_here

# Vendor Bot Gmail Credentials (for vendor-bot.js)
VENDOR_GMAIL_ADDRESS=your_vendor_bot_email@gmail.com
VENDOR_GMAIL_APP_PASSWORD=your_vendor_gmail_app_password

# Dashboard PIN Protection (PIN required to unlock and start negotiations)
DASHBOARD_PIN=your_dashboard_pin_here
